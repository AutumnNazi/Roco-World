[Unit]
Description=Roco World 工具箱（静态服务 + 数据定时同步）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成你的实际部署路径与运行用户
WorkingDirectory=/opt/roco-world
User=www-data
Group=www-data

# 监听 3002 并对外开放；只给 nginx 反代时可改回 127.0.0.1
Environment=HOST=0.0.0.0
Environment=PORT=3002
# 开市时段的商人数据轮询间隔（分钟）
Environment=SYNC_INTERVAL_MINUTES=5
Environment=NODE_ENV=production

ExecStart=/usr/bin/node /opt/roco-world/scripts/serve-local.mjs

Restart=always
RestartSec=5
# 进程被 kill 或系统休眠后 systemd 会自动拉起，定时器随之恢复
StandardOutput=journal
StandardError=journal
SyslogIdentifier=roco-world

[Install]
WantedBy=multi-user.target
